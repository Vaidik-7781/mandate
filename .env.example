# Everything is optional. With no PayPal credentials the app runs in REPLAY mode:
# an in-process PayPal simulator, no network, no API keys.

# --- PayPal SANDBOX (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox            # sandbox only; "live" is refused at startup

# --- LLM (optional; the offline backend works without it) ---
LLM_BACKEND=auto              # auto | offline | anthropic
LLM_API_KEY=
MODEL_NAME=claude-sonnet-5-5

# --- Runtime ---
DATABASE_URL=sqlite:///./mandate.db   # Postgres on Render: postgresql://...
REPLAY_MODE=                          # true/false; empty = replay unless PayPal keys are set
SECRET_SEED=change-me                 # derives demo keys and the guard-token HMAC key
TASK_RUNNER=local                     # local | render (render adapter is unverified)
CORS_ORIGINS=["http://localhost:5173"]

# --- Website (all optional) ---
PUBLIC_BASE_URL=                      # https://your-domain, used in canonical URLs, sitemap, Open Graph
FORCE_HTTPS=false                     # 301 http -> https behind a proxy that sets X-Forwarded-Proto
GA_MEASUREMENT_ID=                    # G-XXXXXXXXXX; loaded only after the visitor accepts analytics
GOOGLE_SITE_VERIFICATION=             # token for Search Console's HTML-tag verification
CONTACT_EMAIL=                        # shown on the contact page
CONTACT_TO=                           # where contact-form emails go (needs SMTP_HOST)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_TOKEN=                          # enables GET /api/contact/messages (Bearer token); unset = route returns 404
