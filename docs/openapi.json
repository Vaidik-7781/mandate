    "properties": {
     "user_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "default": "demo-user"
     },
     "prompt": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Prompt"
     },
     "answers": {
      "additionalProperties": true,
      "type": "object",
      "maxProperties": 20,
      "title": "Answers"
     }
    },
    "type": "object",
    "required": [
